---
import LinkedIn from "../components/icons/LinkedIn.astro";
import GitHub from "../components/icons/GitHub.astro";
import Cv from "../components/icons/Cv.astro";
import {perfil} from "../data/Portafolio.js";
---

<div class="min-h-screen bg-gray-900 text-white flex flex-col overflow-x-hidden pb-5" id="acercaMi">

  <!-- NAVBAR -->
  <nav class="flex justify-between items-center gap-4 pt-10 px-6 sm:px-10 md:px-20 lg:px-32 flex-wrap">
    
    <div class="font-bold text-teal-400 text-4xl">
      Portafolio
    </div>

    <ul class="flex flex-wrap justify-center gap-6 md:gap-12 text-gray-400 text-lg md:text-2xl">
      <li class="hover:text-teal-600"><a href="#acercaMi">Experiencia</a></li>
      <li class="hover:text-teal-600"><a href="#proyectos">Proyecto</a></li>
      <li class="hover:text-teal-600"><a href="#certificados">Certificado</a></li>
      <li class="hover:text-teal-600"><a href="#miContacto">Contacto</a></li>
    </ul>

  </nav>

  <!-- HERO -->
 <!-- HERO -->
<div class="flex flex-1 flex-col-reverse md:flex-row items-center justify-center px-4 sm:px-6 md:px-10 lg:px-20 gap-6 md:gap-16 lg:gap-28 text-center md:text-left overflow-x-hidden">

  <!-- TEXTO -->
  <div class="max-w-full md:max-w-lg space-y-4 md:space-y-6">
    <p class="text-gray-400 text-sm sm:text-base">Hola, soy</p>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-teal-400">{perfil[0].nombre}</h1>
    <p class="text-gray-300 text-base sm:text-lg md:text-xl">{perfil[0].profesion}</p>
    <p class="text-gray-400 text-sm sm:text-base md:text-base text-justify md:text-left">
      {perfil[0].descripcion}
    </p>

    <!-- ICONOS -->
    <div class="flex justify-center md:justify-start gap-3 sm:gap-4 mt-2">
      <div class="bg-gray-800 hover:bg-teal-400 p-2 sm:p-3 rounded"><LinkedIn /></div>
      <div class="bg-gray-800 hover:bg-teal-400 p-2 sm:p-3 rounded"><GitHub /></div>
      <div class="bg-gray-800 hover:bg-teal-400 p-2 sm:p-3 rounded"><Cv /></div>
    </div>
  </div>

  <!-- IMAGEN -->
  <div class="relative w-36 sm:w-48 md:w-64 lg:w-80 h-36 sm:h-48 md:h-64 lg:h-80 mb-6 md:mb-0">
    <img
      src="/images/tonyFoto.jfif"
      alt="Foto"
      class="w-full h-full object-cover rounded-full"
    />
  </div>

</div>


</div>
