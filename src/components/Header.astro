---
import LinkedIn from "../components/icons/LinkedIn.astro";
import GitHub from "../components/icons/GitHub.astro";
import Cv from "../components/icons/Cv.astro";
import {perfil} from "../data/Portafolio.js";
---

<div class="min-h-screen bg-gray-900 text-white flex flex-col" id="acercaMi">

  <!-- NAVBAR -->
  <nav class="flex justify-between items-center gap-4 pt-10 px-32 max-md:flex-col max-md:px-6">
    
    <div class="font-bold text-teal-400 text-4xl">
      Portafolio
    </div>

    <ul class="flex gap-12 text-gray-400 text-2xl max-md:flex-wrap max-md:justify-center max-md:gap-6 max-md:text-base">
      <li class="hover:text-teal-600"><a href="#acercaMi">Experiencia</a></li>
      <li class="hover:text-teal-600"><a href="#proyectos">Proyecto</a></li>
      <li class="hover:text-teal-600"><a href="#certificado">Certificado</a></li>
      <li class="hover:text-teal-600"><a href="#miContacto">Contacto</a></li>
    </ul>

  </nav>

  <!-- HERO -->
  <div class="flex flex-1 items-center justify-center px-20 gap-44 text-left 
              max-md:flex-col max-md:px-6 max-md:gap-10 max-md:text-center">

    <!-- TEXTO -->
    <div class="max-w-lg space-y-6">
      <p class="text-gray-400">Hola, soy</p>
      <h1 class="text-5xl font-bold text-teal-400">{perfil[0].nombre}</h1>
      <p class="text-gray-300">{perfil[0].profesion}</p>
      <p class="text-gray-400 text-justify max-md:text-center">
        {perfil[0].descripcion}
      </p>

      <div class="flex gap-4 max-md:justify-center">
        <div class="bg-gray-800 hover:bg-teal-400 p-3 rounded"><LinkedIn /></div>
        <div class="bg-gray-800 hover:bg-teal-400 p-3 rounded"><GitHub /></div>
        <div class="bg-gray-800 hover:bg-teal-400 p-3 rounded"><Cv /></div>
      </div>
    </div>

    <!-- IMAGEN -->
    <div class="relative w-80 h-80 max-md:w-40 max-md:h-40">
      <img
        src="/images/tonyFoto.jfif"
        alt="Foto"
        class="w-full h-full object-cover rounded-full"
      />
    </div>

  </div>

</div>
