---
import { perfil } from "../data/Portafolio";
import FaceboolIcon from "../components/icons/facebook.astro";
import InstagramIcon from "../components/icons/instagram.astro";
import LinkedIn from "./icons/LinkedIn.astro";
---

<footer class="bg-gray-900 text-gray-300 py-10 px-6" id="miContacto">
  <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-20 text-center">
    <!-- SECCIÓN: Contacto -->
    <div>
      <h2 class="text-xl font-semibold text-white mb-4">Contáctame</h2>
      <p class="mb-2">
        📱 <span class="font-medium">Teléfono:</span>
        {perfil[0].telefono}
      </p>
      <p class="mb-2">
        📧 <span class="font-medium">Correo:</span>
        {perfil[0].email}
      </p>
    </div>

    <!-- SECCIÓN: Enlaces útiles -->
    <div>
      <h2 class="text-xl font-semibold text-white mb-2">Enlaces</h2>
      <ul class="space-y-2">
        <li><a href="#acercaMi" class="hover:text-white">Acerca de mí</a></li>
        <li><a href="#proyectos" class="hover:text-white">Proyectos</a></li>
        <li>
          <a href="#certificados" class="hover:text-white">Certificados</a>
        </li>
      </ul>
    </div>

    <!-- SECCIÓN: Redes Sociales -->
    <div>
      <h2 class="text-xl font-semibold text-white mb-2">Sígueme</h2>
      <div class="flex gap-4 ml-18 md:ml-0 justify-center">
        <a
          href="https://www.linkedin.com/in/anthony-avila-940927262/"
          target="_blank"
          class="flex items-center gap-2"
        >
          <svg
            width="40"
            height="24"
            preserveAspectRatio="xMidYMid"
            viewBox="0 0 256 256"
            {...Astro.props}
          >
            <path
              d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"
              fill="#0A66C2"></path>
          </svg>
        </a>

        <!-- Instagram -->
        <InstagramIcon />
      </div>
    </div>
  </div>

  <!-- SECCIÓN: Derechos reservados -->
  <div
    class="mt-10 border-t border-gray-700 pt-4 text-center text-sm text-gray-400"
  >
    © 2025 Anthony Castro — Todos los derechos reservados.
  </div>
</footer>
